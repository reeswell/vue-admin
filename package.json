{
  "name": "vue-admin",
  "type": "module",
  "version": "0.11.0",
  "private": true,
  "description": "Vue 3 admin dashboard template with Element Plus, Tailwind CSS, and Pinia.",
  "keywords": [
    "vue3",
    "vite",
    "admin-dashboard",
    "element-plus",
    "tailwindcss",
    "pinia",
    "typescript"
  ],
  "author": "Reese Wellin",
  "homepage": "https://nuxt3-admin-reeswell.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/reeswell/nuxt3-admin.git"
  },
  "bugs": {
    "url": "https://github.com/reeswell/nuxt3-admin/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host --port 3000",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview --host --port 3000",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint --cache src vite.config.ts --ext .ts,.vue",
    "lint:fix": "eslint --cache src vite.config.ts --ext .ts,.vue --fix"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@unhead/schema": "^1.11.14",
    "@unhead/vue": "^1.11.20",
    "@vueuse/core": "^10.11.1",
    "@vueuse/integrations": "^10.11.1",
    "animate.css": "^4.1.1",
    "element-plus": "^2.11.5",
    "floating-vue": "^5.2.2",
    "focus-trap": "^7.6.6",
    "fuse.js": "^7.1.0",
    "js-cookie": "^3.0.5",
    "lodash-es": "^4.17.21",
    "ofetch": "^1.4.1",
    "pinia": "^2.3.1",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.27.3",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.3",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^5.2.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.38.0",
    "postcss": "^8.5.3",
    "sass": "^1.93.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-vue-components": "^28.5.0",
    "vite": "^6.3.5",
    "vite-plugin-pages": "^0.33.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vue-tsc": "^2.2.8"
  }
}
